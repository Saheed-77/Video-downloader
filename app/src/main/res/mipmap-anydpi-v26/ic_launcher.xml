<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8+): background + foreground drawables, shaped by the launcher.
     This is the Play-down icon; ic_launcher_midnight is the Midnight one (Settings → Theme). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Used by "themed icons" on Android 13+ (icons tinted to match the wallpaper). -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
